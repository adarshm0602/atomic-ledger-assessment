# Optional: export this variable before starting the app; .env is not loaded automatically.
DATABASE_PATH=data/ledger.sqlite3
# For hosted PostgreSQL, supply DATABASE_URL securely in the hosting environment.
# DATABASE_URL=postgresql://<role>.<project-ref>:<password>@<pooler-host>:5432/postgres
# DATABASE_SCHEMA=ledger
# Set true to insert sample data only if the workspace is empty.
# DEMO_SEED=true
